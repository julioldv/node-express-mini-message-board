
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/styles.css">
  <title>New Message | Mini Message Board</title>
</head>
<body>
    <main class="container">
    <header class="page-header">
        <h1>Write a message</h1>
        <p class="subtitle">Share something with the board.</p>
    </header>

    <section class="form-card">
        <% if (errors.length > 0) { %>
        <div role="alert">
            <p>Please correct the following errors:</p>
            <ul class="error-list">
            <% errors.forEach((error) => { %>
                <li><%= error.msg %></li>
            <% }); %>
            </ul>
        </div>
        <% } %>

        <form action="/new" method="POST">
        <div class="field">
            <label for="user">Author</label>
            <input
            id="user"
            name="user"
            type="text"
            value="<%= values.user %>"
            maxlength="50"
            required
            >
        </div>

        <div class="field">
            <label for="text">Message</label>
            <textarea
            id="text"
            name="text"
            maxlength="1000"
            required
            ><%= values.text %></textarea>
        </div>

        <button class="button" type="submit">
            Post message
        </button>
        </form>
    </section>

    <a class="back-link" href="/">Back to messages</a>
    </main>
</body>
</html>
