<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mini Message Board</title>
</head>
<body>
    <h1>Message Board</h1>
    <p>This is a mini message board to share your thoughts with other users</p>

    <% messages.forEach((item) => { %>
    <article>
        <p><%= item.text %></p>
        <p>Posted by <%= item.user %></p>

        <time datetime="<%= item.added.toISOString() %>">
        <%= item.added.toLocaleString("en-US", {
            dateStyle: "medium",
            timeStyle: "short"
        }) %>
        </time>
        <a href="/messages/<%= item.id %>">Open</a>
    </article>
    <% }); %>
    <a href="/new">Write a new message</a>
</body>
</html>